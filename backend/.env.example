# SatyaNetra backend configuration
# Copy this file to .env and adjust values as needed.

DATABASE_URL=sqlite:///./satyanetra.db
SECRET_KEY=change-this-secret-in-production
GEMINI_API_KEY=
DEMO_MODE=true
MAX_UPLOAD_SIZE_MB=10
DOCUMENT_RETENTION_HOURS=24
CORS_ORIGINS=http://localhost:5173

# --- Optional tuning ---
# Comma-separated paths allowed to serve the API (frontend dev server(s))
# RISK_WEIGHTS is a JSON object; keys: validation, tampering, face, watchlist, identity, ocr
RISK_WEIGHTS={"validation":0.20,"tampering":0.25,"face":0.25,"watchlist":0.15,"identity":0.10,"ocr":0.05}
FACE_MATCH_THRESHOLD=0.85
FACE_REVIEW_THRESHOLD=0.65
TESSERACT_CMD=